{
  "_comment": "Archon-side regressions for the destructive-command guard (security review, 2026-10). Same shape as Stixed's destructive_cases.json; run with Stixed's rules file and home /home/staxed. Jev guard layer Phase 2 (2026-10): scripts fed to or written for a shell, unquoted heredoc and process substitutions, find filters that match everything or the vault's notes, rsync --delete, the knowledge tree and Archon's home. Jev guard layer review fixes (2026-10): a command the guard cannot parse is allowed with a log-only entry; unresolved paths are judged as the Python guard judges them (no separate unresolved-path refusal); find action order, -prune and protected names; rm of every note in a vault folder; commands run in a container.",
  "default_cwd": "/mnt/volumes/projects/stixed",
  "block": [
    {
      "cmd": "git commit -m \"$(cat <<'EOF'\nDon't break\nEOF\n)\" && rm -rf ~",
      "rule": "recursive-delete"
    },
    {
      "cmd": "x=$(cat <<EOF\nit's here\nEOF\n); rm -rf ~",
      "rule": "recursive-delete"
    },
    {
      "cmd": "cat <<'EOF' > notes.txt\nDon't stop\nEOF\nrm -rf ~",
      "rule": "recursive-delete"
    },
    {
      "cmd": "rm -rf \"$ROOT/stixed\"",
      "rule": "recursive-delete"
    },
    {
      "cmd": "cd \"$(git rev-parse --show-toplevel)/..\" && rm -rf stixed",
      "rule": "recursive-delete"
    },
    {
      "cmd": "cd - && rm -rf stixed",
      "rule": "recursive-delete"
    },
    {
      "cmd": "cd \"$X\" && git clean -fdx",
      "rule": "git-wipe"
    },
    {
      "cmd": "git -C \"$X\" clean -fdx",
      "rule": "git-wipe"
    },
    {
      "cmd": "rm -rf \"${A:-${HOME}}\"",
      "rule": "recursive-delete"
    },
    {
      "cmd": "rm -rf \"${A:-$HOME}/\"",
      "rule": "recursive-delete"
    },
    {
      "cmd": "doas rm -rf /etc",
      "rule": "recursive-delete"
    },
    {
      "cmd": "busybox rm -rf /etc",
      "rule": "recursive-delete"
    },
    {
      "cmd": "fish -c 'rm -rf ~'",
      "rule": "recursive-delete"
    },
    {
      "cmd": "rm -rf $'/etc'",
      "rule": "recursive-delete"
    },
    {
      "cmd": "rm -rf $'\\x2fetc'",
      "rule": "recursive-delete"
    },
    {
      "cmd": "printf 'rm -rf ~\\n' | bash",
      "rule": "recursive-delete"
    },
    {
      "cmd": "echo \"rm -rf /etc\" | sh",
      "rule": "recursive-delete"
    },
    {
      "cmd": "bash <<< \"rm -rf ~\"",
      "rule": "recursive-delete"
    },
    {
      "cmd": "bash -euo pipefail <<'EOF'\nrm -rf ~\nEOF",
      "rule": "recursive-delete"
    },
    {
      "cmd": "cat > x.sh <<'EOF'\nrm -rf ~\nEOF\nbash x.sh",
      "rule": "recursive-delete"
    },
    {
      "cmd": "printf 'rm -rf ~\\n' > x.sh && sh x.sh",
      "rule": "recursive-delete"
    },
    {
      "cmd": "cat > x.sh <<'EOF'\nrm -rf ~\nEOF\nchmod +x x.sh && ./x.sh",
      "rule": "recursive-delete"
    },
    {
      "cmd": "cat > notes.txt <<EOF\nnow: $(rm -rf ~)\nEOF",
      "rule": "recursive-delete"
    },
    {
      "cmd": "diff <(ls a) <(ls b); rm -rf ~",
      "rule": "recursive-delete"
    },
    {
      "cmd": "find /mnt/volumes/projects/chat -name '*' -exec rm -rf {} +",
      "rule": "recursive-delete"
    },
    {
      "cmd": "find SecondBrain/Memory -name '*.md' -delete",
      "rule": "recursive-delete"
    },
    {
      "cmd": "rm -rf SecondBrain/Memory/knowledge/concepts",
      "rule": "recursive-delete"
    },
    {
      "cmd": "rsync -a --delete /tmp/empty/ /mnt/volumes/projects/chat/",
      "rule": "recursive-delete"
    },
    {
      "cmd": "rm -rf ~/.archon",
      "rule": "recursive-delete"
    },
    {
      "cmd": "find . -name .git -exec rm -rf {} +",
      "cwd": "/mnt/volumes/projects/Dashed",
      "rule": "recursive-delete"
    },
    {
      "cmd": "find . -path ./node_modules -prune -o -delete",
      "cwd": "/mnt/volumes/projects/Dashed",
      "rule": "recursive-delete"
    },
    {
      "cmd": "rm -f SecondBrain/Memory/daily/*",
      "rule": "vault-delete"
    },
    {
      "cmd": "docker compose exec scheduler rm -rf /app/SecondBrain/Memory/daily",
      "rule": "recursive-delete"
    }
  ],
  "allow": [
    {
      "cmd": "git commit -m \"$(cat <<'EOF'\nDon't break the build\nEOF\n)\""
    },
    {
      "cmd": "x=$(cat <<EOF\nit's fine (really\nEOF\n); printf '%s' \"$x\""
    },
    {
      "cmd": "echo \"unbalanced"
    },
    {
      "cmd": "rm -rf \"$TMPDIR/x\""
    },
    {
      "cmd": "rm -rf \"${TMPDIR:-/tmp}/x\""
    },
    {
      "cmd": "cd \"$(git rev-parse --show-toplevel)\" && rm -rf node_modules dist"
    },
    {
      "cmd": "rm -rf \"$PKG/node_modules\""
    },
    {
      "cmd": "find \"$DIR\" -name '*.pyc' -delete"
    },
    {
      "cmd": "echo 'rm -rf ~' > notes.txt"
    },
    {
      "cmd": "printf 'hello\\n' | bash"
    },
    {
      "cmd": "rm -rf $'build'"
    },
    {
      "cmd": "cat > setup.sh <<'EOF'\nset -e\nrm -rf dist\nEOF\nbash setup.sh"
    },
    {
      "cmd": "rsync -a --delete dist/ /mnt/volumes/projects/Dashed/dist/"
    },
    {
      "cmd": "diff <(ls a) <(ls b) && rm -rf node_modules"
    },
    {
      "cmd": "rm -rf SecondBrain/Memory/knowledge/concepts/dev/some-article.md"
    },
    {
      "cmd": "rm -rf ~/.archon/workspaces/Staxed/stixed/worktrees/archon/fix-x"
    },
    {
      "cmd": "echo \"unbalanced && rm -rf ~",
      "note": "bash rejects a command the guard cannot parse, so nothing in it runs: allowed, with a log-only entry"
    },
    {
      "cmd": "find . -delete 'oops",
      "note": "unparsable: allowed, with a log-only entry"
    },
    {
      "cmd": "git clean -fdx \"oops",
      "note": "unparsable: allowed, with a log-only entry"
    },
    {
      "cmd": "rm -rf \"$1\"",
      "cwd": "/tmp/work",
      "note": "an all-variable target where no protected name could be: left to the judged layer"
    },
    {
      "cmd": "for f in $(cat list.txt); do rm -rf \"$f\"; done",
      "cwd": "/tmp/work",
      "note": "an all-variable target where no protected name could be: left to the judged layer"
    },
    {
      "cmd": "find \"$DIR\" -delete",
      "cwd": "/tmp/work",
      "note": "an unresolved find root that names nothing protected: left to the judged layer"
    },
    {
      "cmd": "rm -rf \"$ROOT\"/dist/*"
    },
    {
      "cmd": "pushd x && rm -rf build && popd && rm -rf dist/*"
    },
    {
      "cmd": "while read -r d; do rm -rf \"$d\"; done < <(find . -name node_modules -prune)"
    },
    {
      "cmd": "cat > clean.sh <<'EOF'\n#!/bin/bash\nrm -rf \"$1\"\nEOF\nbash clean.sh dist"
    }
  ]
}
